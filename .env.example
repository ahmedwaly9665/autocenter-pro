# ══════════════════════════════════════
# AutoCenter Pro - متغيرات البيئة
# ══════════════════════════════════════

# قاعدة البيانات (بيتعبئ تلقائياً في Railway)
DATABASE_URL=postgresql://user:password@localhost:5432/autocenter

# JWT Secret - غيّره لقيمة عشوائية قوية
JWT_SECRET=change_this_to_a_very_long_random_string_min_32_chars

# بيئة التشغيل
NODE_ENV=production

# المنفذ (بيتعبئ تلقائياً في Railway)
PORT=3000

# اسم التطبيق
APP_NAME=AutoCenter Pro

# الدومينات المسموح بها (اتركه * للسماح للكل في الديمو)
ALLOWED_ORIGINS=*
